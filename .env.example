# Server-only. Copy to .env.local; do not commit credentials.
APP_URL=http://localhost:3005
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Signs the app's own session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be at least 32 characters. Rotating it logs everyone out.
APP_JWT_SECRET=
# Supabase service_role key also works in SUPABASE_SECRET_KEY.
DATABASE_URL=
# Required only for schema inspection or direct migration rehearsals.
# Provisioning only; do not persist the bootstrap password after use.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_NAME=
# BOOTSTRAP_TYPE=admin
# BOOTSTRAP_EMPLOYEE_CODE=
